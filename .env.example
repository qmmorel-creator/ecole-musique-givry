# Source des données : "demo" (données fictives dans le navigateur) ou "supabase"
VITE_DATA_SOURCE=
# Uniquement pour VITE_DATA_SOURCE=supabase : URL du projet et clé publique (anon / publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Adresse publique du site (liens de connexion et de réinscription)
VITE_SITE_URL=

# Secrets des fonctions Edge (à définir avec `supabase secrets set`, jamais dans le dépôt ni côté navigateur)
# RESEND_API_KEY=
# MAIL_FROM=
# RATE_LIMIT_SALT=
